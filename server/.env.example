PORT=3000
ADMIN_SECRET=replace-with-a-long-random-value
TELEGRAM_BOT_TOKEN=
FIREBASE_CONFIG=
ALLOWED_ORIGINS=https://almaquake-production.up.railway.app
# Optional tuning; safe defaults are used when omitted.
QUAKE_RADIUS_KM=300
QUAKE_MIN_MAGNITUDE=2.5
QUAKE_LIMIT=100
POLL_INTERVAL_MS=60000
# Railway: attach a Volume mounted at /data, then set this variable.
DATA_DIR=/data
